{
  "version": "3.0.0",
  "bin": "dh",
  "repository": "deephaven/deephaven-mcp",
  "tasks": {
    "dev": "deno run --allow-env --allow-net --allow-read --allow-write --allow-run --allow-sys=hostname src/main.ts",
    "build": "deno run --allow-all scripts/build.ts",
    "release": "deno run --allow-all scripts/release.ts",
    "test": "deno test --allow-all tests",
    "check": "deno fmt --check && deno lint && deno check src scripts tests"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "fmt": {
    "exclude": ["plans/"]
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@deephaven-enterprise/auth-nodejs": "npm:@deephaven-enterprise/auth-nodejs@2026.1.59",
    "@deephaven/jsapi-nodejs": "npm:@deephaven/jsapi-nodejs@^1.29.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@types/react": "npm:@types/react@^19.2.0",
    "ink": "npm:ink@^7.1.1",
    "react": "npm:react@^19.2.0"
  }
}
