{
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run --allow-env --allow-net --allow-read --allow-write src/main.ts",
    "build": "deno run --allow-all scripts/build.ts",
    "demo:update": "deno run --allow-all scripts/demo_update.ts",
    "test": "deno test --allow-all tests",
    "check": "deno fmt --check && deno lint && deno check src scripts tests"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/semver": "jsr:@std/semver@^1.0.8"
  }
}
