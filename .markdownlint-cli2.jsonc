{
  "config": {
    // Rule tweaks are single-sourced in .markdownlint-base.jsonc and
    // shared with the agent-facing relaxed config. Edit rules there.
    "extends": ".markdownlint-base.jsonc"
  },
  "globs": [
    "**/*.md",
    // The .agents tree is excluded from linting EXCEPT the skill catalog
    // (README + every SKILL.md), which is re-included via the trailing
    // positive glob. markdownlint-cli2 does not honor "!" negation inside
    // "ignores" (it renders as "!!" and is not treated as re-inclusion),
    // so the .agents exclusion lives here as ordered globs, not in
    // "ignores". The skills tree is linted under a relaxed rule set: see
    // .agents/skills/.markdownlint.jsonc, which extends the shared
    // .markdownlint-base.jsonc and relaxes MD041.
    "!**/.agents/**",
    "**/.agents/skills/**/*.md"
  ],
  "ignores": [
    "**/.windsurf/**",
    "**/venv*/**",
    "**/.venv*/**",
    "**/TEST*/**",
    "**/node_modules/**",
    "**/.terraform/**"
  ]
}
