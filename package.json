{
  "name": "deephaven-mcp-ts",
  "version": "0.0.1",
  "description": "TypeScript MCP server components for Deephaven",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src-ts/",
    "lint:fix": "eslint src-ts/ --fix",
    "format": "prettier --write src-ts/",
    "format:check": "prettier --check src-ts/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deephaven/jsapi-nodejs": "^1.15.0",
    "@deephaven/jsapi-types": "^41.6.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "apache-arrow": "^21.1.0",
    "async-mutex": "^0.5.0",
    "js-yaml": "^4.1.1",
    "json5": "^2.2.3",
    "openai": "^6.37.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
