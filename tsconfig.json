{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun"],
    "jsx": "react-jsx",

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // The plugin SDK from source, for the example plugins (tsc and esbuild both read this).
    "paths": {
      "@deephaven/cli-plugin": ["./packages/cli-plugin/src/index.ts"],
      "@deephaven/cli-plugin/enterprise": [
        "./packages/cli-plugin/src/enterprise.ts"
      ]
    }
  },
  "include": ["src", "scripts", "tests", "examples/dh-cli-src"]
}
