{
  "schema": 1,
  "api": 1,
  "name": "dbserver",
  "description": "List the cluster's query and merge servers.",
  "requires": "enterprise",
  "commands": [
    {
      "name": "list",
      "description": "List the dispatchers and server groups persistent queries run on.",
      "options": [
        {
          "key": "class",
          "flags": "--class <value>",
          "type": "string",
          "description": "Only servers of this class, e.g. Query or Merge."
        }
      ],
      "output": {
        "kind": "rows",
        "fields": {
          "name": {
            "type": "string",
            "description": "Server name."
          },
          "host": {
            "type": "string",
            "description": "Host; Group for a group."
          },
          "port": {
            "type": "number",
            "description": "Dispatcher port."
          },
          "type": {
            "type": "string",
            "description": "DISPATCHER or GROUP."
          },
          "class": {
            "type": "string",
            "description": "Server class."
          }
        }
      }
    }
  ]
}
