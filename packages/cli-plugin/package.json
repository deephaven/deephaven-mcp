{
  "name": "@deephaven/cli-plugin",
  "version": "0.1.0",
  "description": "Define a TypeScript plugin for the dh CLI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/deephaven/deephaven-mcp.git",
    "directory": "packages/cli-plugin"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enterprise": {
      "types": "./dist/enterprise.d.ts",
      "default": "./dist/enterprise.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p ."
  },
  "dependencies": {
    "@deephaven/jsapi-types": "^1.0.0-dev0.40.5"
  },
  "peerDependencies": {
    "@deephaven-enterprise/jsapi-types": ">=2026.1.0"
  },
  "peerDependenciesMeta": {
    "@deephaven-enterprise/jsapi-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deephaven-enterprise/jsapi-types": "2026.1.59"
  }
}
